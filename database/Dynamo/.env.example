# Copy file này thành .env rồi sửa giá trị nếu cần.
#   Copy-Item .env.example .env   (PowerShell)
#
# Bảng DynamoDB không có secret nào, tất cả đều là optional.
# Bỏ comment dòng nào muốn override.

# AWS_REGION=ap-southeast-1
# PROJECT=archival-demo
# DDB_TABLE=archival-demo-orders

# --- Optional: AWS credentials (nên dùng `aws configure` thay vì để ở đây) ---
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
