# Copy this file to .env and fill in your values.
#   cp .env.example .env      (Git Bash / WSL)
#   Copy-Item .env.example .env   (PowerShell)

# --- Required: RDS master password ---
RDS_MASTER_PASSWORD=change-me-Strong-123!

# --- Optional overrides ---
# AWS_REGION=ap-southeast-1
# PROJECT=archival-demo
# RDS_ENGINE_VERSION=          # để trống = tự chọn version mới nhất
# RDS_INSTANCE_CLASS=db.t4g.micro
# RDS_STORAGE_GB=20
# RDS_DB_NAME=archivedemo
# RDS_MASTER_USER=demoadmin
# RDS_BACKUP_RETENTION_DAYS=1

# --- Optional: AWS credentials (prefer `aws configure` instead) ---
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
