AWS_REGION=ap-southeast-1
S3_BUCKET=<existing-archive-bucket>
ATHENA_RESULTS_PREFIX=athena-results/archiver-data
ATHENA_WORKGROUP=archiver-data

GLUE_DATABASE=archive
# Use the exact table names shown in AWS Glue Data Catalog after partitioning.
# With GLUE_TABLE_PREFIX=orders_rds_ and curated path ending in /orders,
# the crawler normally creates orders_rds_orders. Confirm with discover_tables().
RDS_GLUE_TABLE=orders_rds_orders
DDB_GLUE_TABLE=orders

# Safety guardrail. Athena cancels a query after it scans more than this value.
# AWS requires at least 10 MB. Start with 1 GB for this demo.
BYTES_SCAN_CUTOFF_MB=1024
