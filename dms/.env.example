# Copy this file to dms/.env, then replace every <...> value.
AWS_REGION=ap-southeast-1

# Obtain the host and database settings from database/RDS/run.ipynb -> status().
RDS_ID=archival-demo-pg
RDS_HOST=<your-rds-endpoint>
RDS_PORT=5432
RDS_DATABASE=archivedemo
RDS_USERNAME=demoadmin
RDS_PASSWORD=<your-rds-password>

# The DMS subnet group must use subnets in the same VPC as RDS.
SUBNET_IDS=<subnet-id-1>,<subnet-id-2>
SECURITY_GROUP_IDS=<dms-security-group-id>

# Choose the date column intentionally:
# - closed_at_utc: archive only orders that have been closed long enough.
# - created_at_utc: archive every sufficiently old order, including an open one.
SOURCE_SCHEMA=public
SOURCE_TABLE=orders
DATE_COLUMN=closed_at_utc
ARCHIVE_RETENTION_DAYS=90

# Bucket names are globally unique. Do not include s3:// here.
S3_BUCKET=<globally-unique-bucket-name>
S3_PREFIX=raw/rds/orders

# Glue writes the one-time DMS full load and daily RDS batches to this shared
# Hive-style curated location: year=YYYY/month=MM/day=DD.
CURATED_PREFIX=curated/rds/orders
GLUE_DATABASE=archive
GLUE_TABLE_PREFIX=orders_rds_

DMS_PREFIX=orders-archive
DMS_INSTANCE_CLASS=dms.t3.medium
DMS_STORAGE_GB=50

# Purge (dms/purge_source.py): chỉ chạy sau khi archive đã verify.
# PURGE_CHILD_TABLES dạng table:fk_column, phân cách bằng dấu phẩy. Child rows
# bị xóa cùng parent để không vi phạm foreign key.
PRIMARY_KEY=order_id
PURGE_CHILD_TABLES=order_items:order_id
PURGE_CHECKSUM_COLUMN=amount
PURGE_BATCH_SIZE=500
PURGE_MAX_KEYS=200000
# Chỉ đặt khi DMS task đã bị destroy; phải đúng cutoff của lần full load đó.
# PURGE_CUTOFF=
# ATHENA_OUTPUT=s3://<globally-unique-bucket-name>/athena-results/purge/
# ATHENA_WORKGROUP=primary
