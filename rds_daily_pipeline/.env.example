AWS_REGION=ap-southeast-1
PIPELINE_NAME=orders-rds-daily
SCHEDULE_EXPRESSION=cron(0 2 * * ? *)
ENABLE_SCHEDULE=false

RDS_HOST=<your-rds-endpoint>
RDS_PORT=5432
RDS_DATABASE=archivedemo
RDS_USERNAME=demoadmin
RDS_PASSWORD=<your-rds-password>
SOURCE_SCHEMA=public
SOURCE_TABLE=orders
PRIMARY_KEY=order_id
DATE_COLUMN=closed_at_utc
ARCHIVE_RETENTION_DAYS=90

# Daily setup reads the real cutoff from <DMS_PREFIX>-task TableMappings.
DMS_PREFIX=orders-archive

S3_BUCKET=<existing-archive-bucket>
RAW_PREFIX=raw/rds-daily/orders
CURATED_PREFIX=curated/rds/orders
GLUE_DATABASE=archive
GLUE_TABLE=orders_rds

# Optional overrides. Leave either value blank to derive it from
# <DMS_PREFIX>-instance automatically.
SUBNET_ID=
SECURITY_GROUP_IDS=

# Purge: xóa dữ liệu khỏi RDS sau khi window đã archive và verify xong.
# ENABLE_PURGE=false  -> workflow chỉ archive, RDS giữ nguyên.
# PURGE_DRY_RUN=true   -> verify và in số row sẽ xóa, không DELETE.
# Đặt PURGE_DRY_RUN=false chỉ sau khi một lần dry-run đã PASSED.
ENABLE_PURGE=false
PURGE_DRY_RUN=true
# Child rows bị xóa cùng parent nên phải được archive cùng window.
# Dạng table:fk_column, phân cách bằng dấu phẩy. Để trống nếu không có child.
PURGE_CHILD_TABLES=order_items:order_id
# Cột số dùng làm checksum khi verify. Để trống để bỏ qua bước này.
PURGE_CHECKSUM_COLUMN=amount
PURGE_BATCH_SIZE=500
PURGE_VACUUM=false
