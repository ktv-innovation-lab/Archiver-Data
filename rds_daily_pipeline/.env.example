AWS_REGION=ap-southeast-1
PIPELINE_NAME=orders-rds-daily
SCHEDULE_EXPRESSION=cron(0 2 * * ? *)
ENABLE_SCHEDULE=false

RDS_HOST=<your-rds-endpoint>
RDS_PORT=5432
RDS_DATABASE=archivedemo
RDS_USERNAME=demoadmin
RDS_PASSWORD=<your-rds-password>
SOURCE_SCHEMA=public
SOURCE_TABLE=orders
DATE_COLUMN=closed_at_utc
ARCHIVE_RETENTION_DAYS=90

# Daily setup reads the real cutoff from <DMS_PREFIX>-task TableMappings.
DMS_PREFIX=orders-archive

S3_BUCKET=<existing-archive-bucket>
RAW_PREFIX=raw/rds-daily/orders
CURATED_PREFIX=curated/rds/orders
GLUE_DATABASE=archive
GLUE_TABLE=orders_rds

# Optional overrides. Leave either value blank to derive it from
# <DMS_PREFIX>-instance automatically.
SUBNET_ID=
SECURITY_GROUP_IDS=
